# =========================================================================
# SENTINEL — Environment Configuration
# Copy this file to `.env` and fill in your real values.
# All variables are read by `app/services/llm.py`, `app/services/supabase_*`
# and the streamer via os.environ.
# =========================================================================

# ---- NVIDIA NIM (free tier) -----------------------------------------------
# Get a free key at https://build.nvidia.com — pick "Llama 3.1 8B Instruct".
# Leave blank to run with the deterministic template fallback
# (A5 + A7 will mark narrative_source = "TEMPLATE").
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ---- Supabase (optional — SQLite is the default store) -------------------
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_KEY=YOUR-ANON-KEY
# SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- Neo4j (optional — NetworkX is the default graph backend) -----------
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=neo4j12345

# ---- SENTINEL jurisdiction (default RBI / PMLA / FIU-IND) --------------
SENTINEL_JURISDICTION=IN

# ---- Streamer defaults --------------------------------------------------
SENTINEL_STREAM_RPS=0.5
SENTINEL_STREAM_LIMIT=20