# SENTINEL Dashboard — Environment Configuration
# Copy to .env.local and fill in values.

# Backend (FastAPI from app/main.py)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (used only for optional Realtime + persistent storage)
# Leave blank to run with the FastAPI backend only (polling + REST).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# When 1 (default), the dashboard will fall back to demo data if the API
# is unreachable so the UI is always demonstrable.
NEXT_PUBLIC_DEMO_MODE=1